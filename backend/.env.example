# Copy this file to backend/.env and fill in the values.
# backend/.env is git-ignored: never commit real keys, and don't paste them in chat.

# --- Gemini (aistudio.google.com -> Get API key) ---
GEMINI_API_KEY=

# --- Supabase (Project Settings -> API Keys / Data API) ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=            # "anon public" or "publishable" key (safe for the frontend)
SUPABASE_SERVICE_ROLE_KEY=    # "service_role" or "secret" key (backend only!)

# --- Supabase Postgres (Connect -> Session pooler -> URI), with your DB password filled in ---
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# --- Admins: who can see internals (model routing, LLM usage & cost) ---
ADMIN_EMAILS=                 # comma-separated, e.g. you@example.com

# --- Later (not needed yet) ---
TAVILY_API_KEY=
